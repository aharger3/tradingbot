.env
.env.tastytrade
__pycache__/
*.pyc
circle_data/
circle_videos/
youtube_data/
circle_*.html
journal/signal_log_*.jsonl
journal/*.log
_extract_run.log
spec0_snippets.txt

# media — never in git (GitHub 100MB cap; 21GB+ total)
circle_audio/
research/audio_extracted/
discord_data/images/
*.wav
*.mp4

# ---- rescue pass 2026-08-19 ----
# CREDENTIALS. Never commit. Live OAuth token + Google client secret.
youtube_oauth_token.json
client_secret.json
*.credentials.json

# generated data - regenerated by scripts, never source
data_archive/
# 908 MB of 1-min price cache
data/
.cache/
discord_data/
_omen_mark_days.json

# derived research outputs. Files already tracked stay tracked; anything
# genuinely new and worth keeping goes in with: git add -f <path>
research/*.jsonl
research/*.bak
research/*.backup
research/*.raw
research/*.html
research/worklists.bak-*/
research/research/
research/.corpus_status_mark

# logs and scratch
*.log
*.err
*.bak
full_backtest_output.txt
_alp*.py
_probe*.py
_gate.py
_curate_commit.py
_extract_days.py
_patch_verdict.py
research/test.txt

# per-arm 2-year replay books (P7/G1). ~25 MB each and fully regenerable with
# `python research/p7_84_rule.py run --arm ...`; the same reason
# research/bt2y_trades.json has never been tracked. The finding lives in
# research/p7_84_rule.md, which IS tracked.
research/p7_arm_*.json

# generated decks: rebuild with research/build_deck.py, never commit the HTML
research/decks/**/*.html

# --- NEVER IGNORE A HUMAN JUDGEMENT -------------------------------------
# research/*.jsonl above exists for the tens of thousands of regenerable corpus
# artifacts. It is wider than it looks and has already silently swallowed real
# work twice: 5.2's T6 decks, and t60_silent_days.jsonl + rule_ballot_batch01.
# Austin's marks cannot be regenerated -- see CLAUDE.md, "never lose a mark".
!research/*marks*.jsonl
!research/mark_batch_*.jsonl
!research/*verdicts*.json
!research/*reviews*.jsonl
!research/rule_ballot_*.jsonl
!research/probe_*.jsonl
!research/t60_silent_days.jsonl
!research/marks/**
!research/probes/*.html
!research/decks/*-manifest.jsonl
